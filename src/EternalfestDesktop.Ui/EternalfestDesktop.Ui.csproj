<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>EternalfestDesktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- @spec ui::app-icon: made by mise run icons -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <NeutralLanguage>en</NeutralLanguage>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- @spec packaging::linux-desktop-entry: next to the executable, for the applications menu and Linux shortcuts -->
    <Content Include="Assets\icon.png" Link="icon.png" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <EmbeddedResource Update="Resources\Strings.resx" StronglyTypedLanguage="CSharp" StronglyTypedClassName="Strings" StronglyTypedNamespace="EternalfestDesktop.Ui.Resources" StronglyTypedFileName="$(IntermediateOutputPath)Strings.Designer.cs" PublicClass="true" />
    <InternalsVisibleTo Include="EternalfestDesktop.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EternalfestDesktop.Application\EternalfestDesktop.Application.csproj" />
    <ProjectReference Include="..\EternalfestDesktop.Infrastructure\EternalfestDesktop.Infrastructure.csproj" />
  </ItemGroup>
  <Import Project="..\..\eng\Ruffle.targets" />
  <Import Project="..\..\eng\FlashPlayer.targets" />
</Project>
